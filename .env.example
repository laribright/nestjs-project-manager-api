# App
PORT=3000
APP_NAME=Project Manager API
TASK_DEFAULT_STATUS=todo
MAIL_FROM=noreply@example.com

# PostgreSQL (required)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/project_manager

# JWT — must be at least 64 characters
JWT_ACCESS_SECRET=replace-me-with-a-long-random-secret-at-least-64-chars-long!!

# Redis / Upstash (BullMQ queues)
UPSTASH_REDIS_HOST=your-redis-host.upstash.io
UPSTASH_REDIS_PORT=6379
UPSTASH_REDIS_PASSWORD=your-redis-password
